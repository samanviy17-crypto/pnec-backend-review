# Development example; copy only to a new ignored local file, never overwrite.
FLASK_ENV=development
SECRET_KEY=
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=PNEC Admin
PUBLIC_CONTACT_EMAIL=
FRONTEND_URL=http://127.0.0.1:4000
MAIL_DELIVERY=console
# Production requires explicit persistent DATABASE_URL, SECRET_KEY, frontend origin.
# Store real values in the host secret manager, not Git or shell history.
DATABASE_URL=
ALLOWED_FRONTEND_ORIGINS=https://pnec.opencodingsociety.com
UPLOAD_FOLDER=
SECURITY_STATE_PATH=
BEARER_TOKEN_MAX_AGE=86400
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_RATE_LIMIT_PER_MINUTE=20
REDIS_URL=
# Optional unused browser-push integration: leave blank unless separately reviewed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
# Keep repository publishing disabled. It is not needed to deploy or run PNEC.
GITHUB_PUBLISH_ENABLED=false
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=review-only
PORT=8425
BIND_ADDRESS=127.0.0.1
WEB_CONCURRENCY=2

# Owner-controlled account-ID -> neighborhood-ID assignments; no residential fallback.
COORDINATOR_ASSIGNMENTS={}
# REQUIRED owner-confirmed historical interpretation: UTC or America/Los_Angeles.
# Leave blank until reviewed. Fresh databases should explicitly choose UTC.
EVENT_STORAGE_TIMEZONE=
