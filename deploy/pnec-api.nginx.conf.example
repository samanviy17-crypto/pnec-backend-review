# PROPOSED TEMPLATE ONLY. Identify real upstream/certificate paths before use.
server {
    listen 80;
    server_name powaynec-api.opencodingsociety.com;
    location ^~ /.well-known/acme-challenge/ { root @ACME_WEBROOT@; }
    location / { return 301 https://powaynec-api.opencodingsociety.com$request_uri; }
}
server {
    listen 443 ssl;
    server_name powaynec-api.opencodingsociety.com;
    ssl_certificate @FULLCHAIN_FILE@;
    ssl_certificate_key @PRIVATE_KEY_FILE@;
    client_max_body_size 20m;
    location / {
        proxy_pass http://127.0.0.1:@UPSTREAM_PORT@;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }
    # Flask is the single CORS authority. No add_header Access-Control-* and
    # no generic OPTIONS shortcut: unknown routes must not appear supported.
}
