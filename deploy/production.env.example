# TEMPLATE ONLY. Preserve existing approved secret values; never commit a real env file.
FLASK_ENV=production
FRONTEND_URL=https://powaynec.opencodingsociety.com
PNEC_REVIEW_EPHEMERAL=false
SECRET_KEY=
# Choose exactly one: DATABASE_URL OR all DB_ENDPOINT/DB_USERNAME/DB_PASSWORD.
DATABASE_URL=
